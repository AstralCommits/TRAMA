#!/usr/bin/env sh
set -eu
MVN_VERSION=3.9.9
if command -v mvn >/dev/null 2>&1; then
  exec mvn -f "$(dirname "$0")/pom.xml" "$@"
fi
BASE="${HOME}/.m2/wrapper/dists/apache-maven-${MVN_VERSION}"
HOME_MVN="${BASE}/apache-maven-${MVN_VERSION}"
if [ ! -x "${HOME_MVN}/bin/mvn" ]; then
  mkdir -p "$BASE"
  ARCHIVE="${BASE}/apache-maven-${MVN_VERSION}-bin.tar.gz"
  URL="https://archive.apache.org/dist/maven/maven-3/${MVN_VERSION}/binaries/apache-maven-${MVN_VERSION}-bin.tar.gz"
  if command -v curl >/dev/null 2>&1; then curl -fL "$URL" -o "$ARCHIVE"; else wget -O "$ARCHIVE" "$URL"; fi
  tar -xzf "$ARCHIVE" -C "$BASE"
fi
exec "${HOME_MVN}/bin/mvn" -f "$(dirname "$0")/pom.xml" "$@"
